{
	"name": "@certible/remark-links-extractor",
	"version": "1.0.0",
	"description": "Remark plugin to extract internal, external and hash links from parsed AST markdown",
	"keywords": [
		"astro",
		"markdown",
		"mdx",
		"remark"
	],
	"bugs": {
		"url": "https://github.com/certible/remark-links-extractor/issues"
	},
	"license": "MIT",
	"author": "Certible <oberreiter@certible.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/certible/remark-links-extractor.git"
	},
	"files": [
		"index.d.ts",
		"index.js",
		"lib/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "index.js",
	"exports": "./index.js",
	"scripts": {
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix && oxfmt .",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"build": "tsc --build --clean && tsc --build",
		"test": "pnpm run build && node --test"
	},
	"dependencies": {
		"github-slugger": "2.0.0",
		"hast-util-from-html": "2.0.3",
		"hast-util-has-property": "3.0.0",
		"is-absolute-url": "5.0.0",
		"mdast-util-mdx-jsx": "3.2.0",
		"mdast-util-to-string": "4.0.0",
		"unist-util-visit": "5.0.0"
	},
	"devDependencies": {
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"oxfmt": "0.53.0",
		"oxlint": "1.67.0",
		"remark": "15.0.1",
		"remark-parse": "11.0.0",
		"typescript": "^5.7.3",
		"vfile": "6.0.3",
		"vitest": "4.0.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "pnpm@11.4.0"
}
